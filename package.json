{
  "name": "tildom",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev:do": "pnpm --filter do.tildom dev",
    "dev:home": "pnpm --filter home.tildom dev",
    "dev:kin": "pnpm --filter kin.tildom dev",
    "dev:mark": "pnpm --filter mark.tildom dev",
    "dev:api": "cd services/api && go run .",
    "dev:sync": "cd services/sync && go run .",
    "build": "pnpm --filter './apps/*' build && pnpm build:api && pnpm build:sync",
    "build:do": "pnpm --filter do.tildom build",
    "build:home": "pnpm --filter home.tildom build",
    "build:kin": "pnpm --filter kin.tildom build",
    "build:mark": "pnpm --filter mark.tildom build",
    "build:api": "cd services/api && go build -o bin/tildom-api .",
    "build:sync": "cd services/sync && go build -o bin/tildom-sync .",
    "test": "pnpm --filter './apps/*' --filter './packages/*' test && pnpm test:sync && pnpm test:api",
    "test:do": "pnpm --filter do.tildom test",
    "test:kin": "pnpm --filter kin.tildom test",
    "test:mark": "pnpm --filter mark.tildom test",
    "test:api": "cd services/api && go test -v ./...",
    "test:sync": "cd services/sync && go test -v ./...",
    "test:e2e": "pnpm --filter mark.tildom test:e2e && pnpm --filter kin.tildom test:e2e && pnpm --filter do.tildom test:e2e",
    "test:e2e:do": "pnpm --filter do.tildom test:e2e",
    "test:e2e:kin": "pnpm --filter kin.tildom test:e2e",
    "test:e2e:mark": "pnpm --filter mark.tildom test:e2e",
    "typecheck": "pnpm --filter './apps/*' --filter './packages/*' typecheck && pnpm typecheck:sync && pnpm typecheck:api",
    "typecheck:api": "cd services/api && go vet ./...",
    "typecheck:do": "pnpm --filter do.tildom typecheck",
    "typecheck:home": "pnpm --filter home.tildom typecheck",
    "typecheck:kin": "pnpm --filter kin.tildom typecheck",
    "typecheck:mark": "pnpm --filter mark.tildom typecheck",
    "typecheck:sync": "cd services/sync && go vet ./..."
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
